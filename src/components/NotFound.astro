---
/**
 * The branded 404 body — rendered by `pages/404.astro` for any address with no
 * page, and by the post page for an unknown slug. Both set a 404 status.
 */
import type {Site} from '../lib/types';
import BrandMark from './BrandMark.astro';

interface Props {
  site: Site | null;
}

const {site} = Astro.props;
---

<main id="main" tabindex="-1" class="wrap narrow section center">
  <BrandMark site={site} size={56} />
  <p class="eyebrow not-found-code">404</p>
  <h1>This page does not exist</h1>
  <p class="lede">The page you were looking for isn’t part of {site?.name ?? 'this site'}.</p>
  <p class="not-found-actions">
    <a class="button" href="/help/">Browse the help center</a>
    <a class="button button-secondary" href="/" data-astro-prefetch>Back to home</a>
  </p>
  <form class="not-found-search" action="/help/search/" method="get" role="search" novalidate>
    <div class="field">
      <label for="not-found-q">Or search for an answer</label>
      <input id="not-found-q" name="q" type="search" maxlength="120" placeholder="For example: change my delivery address" />
    </div>
  </form>
</main>
