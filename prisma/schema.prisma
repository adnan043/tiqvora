// The Site Database's schema (Prisma ORM 7). Change it, then run
// `npx prisma migrate dev --create-only --name <what-changed>` against the
// Preview Database, wrap the new migration.sql in BEGIN; … COMMIT;, apply it
// with `npx prisma migrate dev`, then `npx prisma generate` (docs/agent/database.md).
//
// Tables marked MANAGED belong to the template's auth core (src/platform/auth):
// add columns to them only through a template upgrade.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // The client runs in the Cloudflare Workers runtime, never in Node.
  runtime         = "workerd"
  // ONE SQL query per read: a nested `select` of related rows is joined in the database instead
  // of one extra query per relation (each query is a round trip). docs/agent/database.md.
  previewFeatures = ["relationJoins"]
}

// TESTS ONLY: the same client for Node, so `npm test` can run the real Site API
// against a real Postgres (vitest aliases the import to it). Never imported by
// site code; git-ignored like the one above.
generator nodeClient {
  provider        = "prisma-client"
  output          = "../src/generated/prisma-node"
  runtime         = "nodejs"
  previewFeatures = ["relationJoins"]
}

// The connection string is NOT here: prisma.config.ts reads DATABASE_URL from
// the environment, which the platform sets (the Build never gets one).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- auth (MANAGED)

/// A person with an account on this site. `email` is stored trimmed and
/// lower-cased. Only the user and holders of `site:user:read` ever see it.
model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(254)
  /// The platform's opaque id, on the site owner's account only (src/platform/auth/owner.ts).
  platformOwnerId   String?   @unique @map("platform_owner_id") @db.VarChar(64)
  /// A versioned hash string (src/platform/auth/password.ts).
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  name              String    @db.VarChar(80)
  /// `active` or `suspended`.
  status            String    @default("active") @db.VarChar(16)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  /// Bumped on password change, logout-all and suspension: every access token
  /// carrying an older value stops working at once.
  sessionVersion    Int       @default(1) @map("session_version")
  lastLoginAt       DateTime? @map("last_login_at")
  /// Two-step sign-in (src/platform/auth/two-factor.ts): the authenticator secret, SEALED
  /// (never in clear), set once the user confirmed a first code (`totpEnabledAt`).
  totpSecretSealed  String?   @map("totp_secret_sealed") @db.VarChar(255)
  /// A secret shown during setup, not yet confirmed with a code.
  totpPendingSealed String?   @map("totp_pending_sealed") @db.VarChar(255)
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  /// The 30-second step of the last accepted code: that code (and older) never works again.
  totpLastStep      Int?      @map("totp_last_step")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  emailChanges       EmailChange[]
  recoveryCodes      RecoveryCode[]
  signInCodes        SignInCode[]

  // Help desk (Phase 3): Prisma relation fields only, no column on `users`.
  conversations   Conversation[]
  assignedTickets Ticket[]       @relation("TicketAssignee")
  ticketViews     TicketView[]

  @@index([status, id])
  @@map("users")
}

/// A role: a named set of permissions. `is_system` roles (owner, admin,
/// member) are seeded and cannot be deleted; `owner` cannot be edited.
model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(48)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// The permission catalogue: one row per codename (`site:job:manage`,
/// `site:user:*`, `*`). Shipped as idempotent migrations, matched by codename.
model Permission {
  id          Int      @id @default(autoincrement())
  codename    String   @unique @db.VarChar(128)
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  /// Groups the catalogue in the roles screen ("Users", "Jobs").
  groupName   String   @default("General") @map("group_name") @db.VarChar(48)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedBy    Int?     @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  grantedBy Int?     @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

/// One refresh token, stored only as its SHA-256. Tokens of one sign-in share
/// a `family_id`; each rotation marks the old row used and points the new
/// row at it (`rotated_from`). Reuse of a used token revokes the family.
model RefreshToken {
  id                BigInt    @id @default(autoincrement())
  familyId          String    @map("family_id") @db.Uuid
  userId            Int       @map("user_id")
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  rotatedFromId     BigInt?   @map("rotated_from")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(16)
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipHash            String?   @map("ip_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A single-use password reset link (30 minutes), stored as its SHA-256.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_resets")
}

/// A single-use email confirmation link (24 hours), stored as its SHA-256.
model EmailVerification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// The address this link confirms (the user's email when it was sent).
  email     String    @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// A 6-digit sign-in code emailed to the account (src/platform/auth/code-routes.ts): 10 minutes,
/// single use, 5 wrong tries and it is spent. Only its keyed hash is stored. A new code ends the
/// older ones.
model SignInCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  tries     Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("sign_in_codes")
}

/// Rate-limit ledger: one row per attempt. Keyed hashes only (never the raw
/// email or IP). Rows older than a day are swept on the way.
/// A sign-up waiting for its emailed code. No account exists until the same browser enters the
/// code: that proves it chose this password and that it reads the inbox.
model PendingSignUp {
  id           Int       @id @default(autoincrement())
  email        String    @db.VarChar(254)
  name         String    @db.VarChar(80)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  browserHash  String    @map("browser_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  ipHash       String?   @map("ip_hash") @db.Char(64)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([email, browserHash])
  @@index([browserHash])
  @@index([expiresAt])
  @@map("pending_sign_ups")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  /// `login`, `register`, `reset`, `verify`, `password`, `code`, `codecheck`, ….
  kind      String   @db.VarChar(16)
  emailHash String?  @map("email_hash") @db.Char(64)
  ipHash    String   @map("ip_hash") @db.Char(64)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, emailHash, createdAt])
  @@index([kind, ipHash, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Security-relevant events (sign-ups, password changes, role changes,
/// refresh-token reuse). No email addresses, no raw IPs, no secrets.
/// A pending move of an account to a new address: the link mailed to the NEW address
/// (`/account/confirm-email/?token=…`) finishes it; single use, 24 hours.
model EmailChange {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  newEmail  String    @map("new_email") @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_changes")
}

/// Two-step sign-in recovery codes, as SHA-256 hashes; each works once.
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(64)
  ipHash      String?  @map("ip_hash") @db.Char(64)
  /// Small, non-personal details (`{"roles":["admin"]}`). Never filtered on.
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, id])
  @@index([targetType, targetId, id])
  @@map("audit_events")
}

/// One row (`id = 1`): the account holding the owner seat, taken with a conditional
/// update, and the `SITE_OWNER_ID` this database last saw.
model AuthState {
  id          Int      @id
  ownerUserId Int?     @map("owner_user_id")
  ownerEnvId  String?  @map("owner_env_id") @db.VarChar(64)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("auth_state")
}

/// Background job deliveries already taken (`src/platform/background.ts`): the
/// replay guard for signed deliveries, across every Worker instance. One row
/// per job try; rows older than a day are swept on the way.
model JobDelivery {
  jobId   String   @map("job_id")
  attempt Int
  seenAt  DateTime @default(now()) @map("seen_at")

  @@id([jobId, attempt])
  @@index([seenAt])
  @@map("job_deliveries")
}

// ---------------------------------------------------------------- payments (MANAGED)
// Filled by src/server/payments-hooks.ts from the platform's payment events (and the thanks
// page's confirm). Add columns only through a template upgrade; keep your own data in your own
// tables, pointing at `checkout_id` / `subscription_id`.

/// Payment events already handled, by event id (`src/platform/payments.ts`): a retried or
/// replayed event runs its hook once. Rows older than 90 days are swept on the way.
model PaymentEvent {
  id         String   @id @db.VarChar(128)
  type       String   @db.VarChar(40)
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("payment_events")
}

/// One thing that must happen once (`idempotent` in src/platform/idempotency.ts): the first request
/// runs it, a repeat of the same `key` gets `response`. Kept for 7 days.
model IdempotencyKey {
  id          Int      @id @default(autoincrement())
  scope       String   @db.VarChar(120)
  key         String   @db.VarChar(64)
  fingerprint String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// One paid (or failed / refunded) checkout. `checkout_id` is the platform's `pcs_…`.
model Order {
  id          Int       @id @default(autoincrement())
  checkoutId  String    @unique @map("checkout_id") @db.VarChar(80)
  priceKey    String    @map("price_key") @db.VarChar(63)
  /// `test` (sandbox) or `live`.
  mode        String    @default("test") @db.VarChar(4)
  email       String?   @db.VarChar(254)
  /// The signed-in buyer (`users.id`), from the checkout's `customerRef`. No foreign key: an
  /// order outlives a deleted account.
  userId      Int?      @map("user_id")
  /// `paid`, `failed`, `refunded` or `partially_refunded`.
  status      String    @db.VarChar(20)
  quantity    Int       @default(1)
  amountCents Int       @map("amount_cents")
  currency    String    @db.Char(3)
  metadata    Json?
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, id])
  @@index([email, id])
  @@map("orders")
}

/// A subscription bought on this site. Access: `active`, `trialing`, `past_due`, or `canceled`
/// until `access_ends_at` (`grantsAccess` in src/platform/payments.ts).
model Membership {
  id               Int       @id @default(autoincrement())
  subscriptionId   String    @unique @map("subscription_id") @db.VarChar(128)
  priceKey         String    @map("price_key") @db.VarChar(63)
  mode             String    @default("test") @db.VarChar(4)
  email            String?   @db.VarChar(254)
  userId           Int?      @map("user_id")
  status           String    @db.VarChar(20)
  currentPeriodEnd DateTime? @map("current_period_end")
  accessEndsAt     DateTime? @map("access_ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, priceKey])
  @@index([email, priceKey])
  @@map("memberships")
}

// ---------------------------------------------------------------- the site's own data

/// A job on the job board (`/jobs`, `/jobs/<slug>`). Holders of
/// `site:job:manage` post and edit them from `/portal/jobs`.
model Job {
  id          Int      @id @default(autoincrement())
  /// URL name, unique: `/jobs/<slug>`.
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(120)
  company     String   @db.VarChar(80)
  location    String   @db.VarChar(80)
  /// `full-time`, `part-time`, `contract` or `internship`.
  type        String   @default("full-time") @db.VarChar(20)
  remote      Boolean  @default(false)
  /// Plain text; paragraphs separated by blank lines.
  description String   @db.VarChar(10000)
  /// Where to apply: an https URL or a mailto: link the poster chose to publish.
  applyUrl    String   @map("apply_url") @db.VarChar(500)
  /// `open` (listed) or `closed` (kept, not listed).
  status      String   @default("open") @db.VarChar(10)
  /// The user (`users.id`) who posted it. No foreign key: a job outlives its poster.
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, id])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Help desk: settings and the knowledge base (Phase 1). Search is Postgres
// full-text search on `kb_chunks` through an expression GIN index created in
// the migration SQL (src/server/kb/search.ts holds the one matching expression).

/// The help desk's settings: ONE row, id = 1 (CHECK in the migration).
/// Read through the Site Cache (`helpdesk:settings`), cleared on save.
model HelpdeskSettings {
  id                  Int      @id @default(1)
  /// The assistant's name in the chat panel.
  assistantName       String   @default("Assistant") @map("assistant_name") @db.VarChar(60)
  greeting            String   @default("Hi! Ask me anything about our products and orders.") @db.VarChar(300)
  /// `friendly`, `neutral` or `formal`.
  tone                String   @default("friendly") @db.VarChar(10)
  /// Hand off below this: `low`, `medium` or `high`.
  confidenceThreshold String   @default("medium") @map("confidence_threshold") @db.VarChar(10)
  /// `anthropic` or `openai`.
  provider            String   @default("anthropic") @db.VarChar(12)
  /// From the allow-list in code; empty = the provider's default.
  model               String   @default("") @db.VarChar(60)
  monthlyCapCents     Int      @default(2000) @map("monthly_cap_cents")
  launcherLabel       String   @default("Support") @map("launcher_label") @db.VarChar(30)
  businessHours       String   @default("") @map("business_hours") @db.VarChar(200)
  /// The help center's own words (`/help/`).
  helpTitle           String   @default("How can we help?") @map("help_title") @db.VarChar(120)
  helpIntro           String   @default("Search our guides, or ask the assistant.") @map("help_intro") @db.VarChar(300)
  /// IANA zone for the weekly Knowledge health check (Mondays 07:30 local). Canonical form
  /// (`Intl…resolvedOptions().timeZone`), validated by src/lib/time-zone.ts. CHECK on shape.
  timeZone            String   @default("UTC") @map("time_zone") @db.VarChar(64)
  updatedBy           Int?     @map("updated_by")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("helpdesk_settings")
}

/// Quick-reply chips shown in the chat panel, in order.
model HelpdeskQuickReply {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(60)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([position, id])
  @@map("helpdesk_quick_replies")
}

/// Topics the assistant never answers: a keyword match hands off to a person.
model HelpdeskHumanTopic {
  id        Int      @id @default(autoincrement())
  /// Lower-case, trimmed.
  keyword   String   @unique @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("helpdesk_human_topics")
}

model KbCategory {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(80)
  /// URL name, unique: `/help/<slug>/`.
  slug         String      @unique @db.VarChar(80)
  description  String      @default("") @db.VarChar(300)
  /// A name from ICON_NAMES (src/portal/ui/icon.tsx).
  icon         String      @default("book") @db.VarChar(30)
  position     Int         @default(0)
  /// PUBLISHED articles in it, kept on write (never count() per request).
  articleCount Int         @default(0) @map("article_count")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  articles     KbArticle[]

  @@index([position, id])
  @@map("kb_categories")
}

model KbArticle {
  id              Int        @id @default(autoincrement())
  /// Restrict: a category with articles can't be deleted (move them first).
  categoryId      Int        @map("category_id")
  title           String     @db.VarChar(160)
  /// URL name, unique: `/help/articles/<slug>/`.
  slug            String     @unique @db.VarChar(160)
  /// Markdown; the validator caps it at 50,000 characters and 60,000 UTF-8 bytes.
  body            String     @db.Text
  excerpt         String     @default("") @db.VarChar(300)
  /// `draft`, `published` or `archived` (CHECK in the migration).
  status          String     @default("draft") @db.VarChar(10)
  publishedAt     DateTime?  @map("published_at") @db.Timestamptz(3)
  lastReviewedAt  DateTime   @default(now()) @map("last_reviewed_at") @db.Timestamptz(3)
  helpfulCount    Int        @default(0) @map("helpful_count")
  notHelpfulCount Int        @default(0) @map("not_helpful_count")
  viewCount       Int        @default(0) @map("view_count")
  /// `users.id`. No foreign key: an article outlives its author (like `jobs.created_by`).
  createdBy       Int        @map("created_by")
  updatedBy       Int        @map("updated_by")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  category        KbCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  chunks          KbChunk[]
  healthIssues    HealthIssue[]
  testCases       TestCase[]

  /// A category's articles by status (the FK first).
  @@index([categoryId, status, id])
  /// All articles by status, keyset by id (public list, manage filter).
  @@index([status, id])
  /// Popular published articles.
  @@index([status, viewCount(sort: Desc), id(sort: Desc)])
  @@map("kb_articles")
}

/// Short Q&A the assistant may use; never shown publicly.
model KbSnippet {
  id        Int       @id @default(autoincrement())
  question  String    @db.VarChar(300)
  answer    String    @db.VarChar(2000)
  createdBy Int       @map("created_by")
  updatedBy Int       @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  chunks    KbChunk[]

  @@map("kb_snippets")
}

/// What search and the assistant read: a PUBLISHED article split by heading,
/// or one snippet. Exactly one of articleId / snippetId (CHECK). Rebuilt in the
/// same transaction as the article or snippet it comes from.
model KbChunk {
  id        Int                      @id @default(autoincrement())
  articleId Int?                     @map("article_id")
  snippetId Int?                     @map("snippet_id")
  position  Int                      @default(0)
  heading   String                   @default("") @db.VarChar(200)
  text      String                   @db.VarChar(2000)
  /// The full-text search vector, kept by the database: the BEFORE INSERT OR UPDATE OF
  /// heading, text trigger `kb_chunks_search_vec_trg` (migration ..._kb_chunks_search_vec)
  /// sets it to setweight(to_tsvector('simple', heading), 'A') || setweight(to_tsvector('simple', text), 'B').
  /// Never written by app code; read only in raw SQL (`KB_SEARCH_VECTOR`, src/server/kb/search.ts).
  searchVec Unsupported("tsvector")? @map("search_vec")
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  article   KbArticle?               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  snippet   KbSnippet?               @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@index([articleId, position])
  @@index([snippetId])
  @@index([searchVec], type: Gin)
  @@map("kb_chunks")
}

/// Request counters per minute, for public routes with no account to limit by
/// (help-center search, feedback, views; the assistant later): per client (a
/// keyed IP hash) and site-wide. One conditional upsert per bucket
/// (src/server/rate-window.ts); the hourly `rate-windows-cleanup` background job
/// deletes minutes older than an hour.
model RateWindow {
  /// What is counted: `kb-search` (site-wide), `s:<ip hash>` (one client), …
  bucket String   @db.VarChar(40)
  /// The minute, truncated.
  minute DateTime @db.Timestamptz(3)
  count  Int      @default(0)

  @@id([bucket, minute])
  @@map("rate_windows")
}

// ---------------------------------------------------------------------------
// Help desk, Phase 2: the AI assistant.

/// One question asked of the assistant (analytics, Knowledge Health). Anonymous on
/// purpose: NO user id, NO IP, NO page beyond its path. Append-heavy: BigInt id.
model QuestionLog {
  id           BigInt   @id @default(autoincrement())
  /// The customer's words, ≤ 500 (the validator's cap).
  question     String   @db.VarChar(500)
  /// A BCP 47 tag from the browser (`en`, `pt-BR`), or ''.
  language     String   @default("") @db.VarChar(16)
  /// The page the question was asked on: a path only, never a query string.
  pagePath     String   @default("") @map("page_path") @db.VarChar(300)
  /// The best matching article. No foreign key: the log outlives a deleted article.
  topArticleId Int?     @map("top_article_id")
  /// `high`, `medium`, `low` or `none` (CHECK).
  confidence   String   @default("none") @db.VarChar(8)
  /// `answered`, `no_source`, `handed_off` or `ai_off` (CHECK).
  outcome      String   @db.VarChar(12)
  /// The customer's thumbs up / down; null until they say.
  helpful      Boolean?
  model        String   @default("") @db.VarChar(60)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costMicros   Int      @default(0) @map("cost_micros")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// The week's questions (Knowledge Health, reports), keyset by id.
  @@index([createdAt, id])
  /// Analytics' question list filtered by outcome, newest first (routes/helpdesk-reports.ts).
  @@index([outcome, id])
  /// Analytics' "Not helpful" filter, newest first.
  @@index([helpful, id])
  @@map("question_logs")
}

/// AI spend per calendar month (UTC). One conditional update per call enforces the
/// owner's monthly cap (src/server/ai/usage.ts): never read, check, then write.
model AiUsage {
  /// The first day of the month.
  month       DateTime @id @db.Date
  spentMicros BigInt   @default(0) @map("spent_micros")
  requests    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_usage")
}

// ---------------------------------------------------------------------------
// Help desk, Phase 3: talking to a person. Design: status lives ONLY on
// conversations (tickets.solved_at mirrors "solved" in the same statement,
// src/server/helpdesk/state.ts); tile counters are kept on write.

/// One customer's conversation with the team, created at hand-off.
model Conversation {
  id             Int      @id @default(autoincrement())
  /// The customer. SetNull: a deleted account leaves the ticket for the team, anonymised
  /// ("Deleted customer"); nothing links it back to the person.
  userId         Int?     @map("user_id")
  /// `ai`, `waiting`, `open`, `pending` or `solved` (CHECK). Hand-off creates `waiting`.
  status         String   @default("waiting") @db.VarChar(8)
  /// `confirmed` (the customer said so), `assumed` (an agent solved it) or `none` (CHECK).
  resolution     String   @default("none") @db.VarChar(9)
  /// The page the hand-off started on: a path, no query.
  pagePath       String   @default("") @map("page_path") @db.VarChar(300)
  language       String   @default("") @db.VarChar(16)
  /// The client's key for the create. Unique per user (idempotent hand-off).
  requestKey     String   @map("request_key") @db.VarChar(64)
  /// An agent replied since the customer last opened it ("My support" badge; no emails exist).
  customerUnread Boolean  @default(false) @map("customer_unread")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Last customer or agent message (notes don't move it): inbox order and age.
  lastMessageAt  DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages Message[]
  ticket   Ticket?

  @@unique([userId, requestKey])
  /// My support: my conversations, newest first (also the FK's index).
  @@index([userId, id])
  /// Pending and Solved queues.
  @@index([status, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

/// One line of a conversation. Append-heavy: BigInt id (a string in JSON).
model Message {
  id             BigInt   @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  /// `customer`, `ai`, `agent` or `note` (CHECK). `note` is internal: never sent to the customer.
  sender         String   @db.VarChar(8)
  /// `users.id` of the customer or agent. No FK: a message outlives its author's account. Null for `ai`.
  authorUserId   Int?     @map("author_user_id")
  /// Plain text, 1–4000. Never HTML.
  body           String   @db.VarChar(4000)
  /// `ai` lines: [{id: number|null, title, url}] (≤ 5), what the assistant showed. Snapshot.
  citedArticles  Json?    @map("cited_articles")
  /// `ai` lines: `high|medium|low|none`, else null.
  confidence     String?  @db.VarChar(8)
  tokens         Int      @default(0)
  costMicros     Int      @default(0) @map("cost_micros")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@map("messages")
}

/// The staff side of a conversation (1:1): number, subject, priority, assignee, AI summary, CSAT.
model Ticket {
  id              Int       @id @default(autoincrement())
  conversationId  Int       @unique @map("conversation_id")
  /// Shown to people (#1001…). Gaps are normal. Never a secret: every route authorizes.
  number          Int       @unique @default(autoincrement())
  subject         String    @db.VarChar(120)
  /// `low`, `normal`, `high`, `urgent` (CHECK).
  priority        String    @default("normal") @db.VarChar(6)
  /// SetNull: an agent's deleted account un-assigns.
  assigneeId      Int?      @map("assignee_id")
  aiSummary       String?   @map("ai_summary") @db.VarChar(1200)
  /// `pending`, `ready` or `unavailable` (CHECK).
  aiSummaryState  String    @default("pending") @map("ai_summary_state") @db.VarChar(11)
  /// The article links the assistant showed before the hand-off: [{id|null,title,url}] ≤ 10.
  aiSources       Json?     @map("ai_sources")
  /// Mirrors conversations.status = 'solved' (same statement). Null = not solved.
  solvedAt        DateTime? @map("solved_at") @db.Timestamptz(3)
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz(3)
  /// 1–5 (CHECK), once, only while solved.
  csat            Int?      @db.SmallInt
  csatAt          DateTime? @map("csat_at") @db.Timestamptz(3)
  /// When the article-draft job finished with this ticket (a draft written, nothing to draft, or
  /// given up). Null on a solved ticket = still to do (partial index tickets_draft_unchecked_idx).
  draftCheckedAt  DateTime? @map("draft_checked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  views        TicketView[]
  healthIssue  HealthIssue?

  /// Assigned to me (assignee = me AND solved_at IS NULL), also the FK's index.
  @@index([assigneeId, solvedAt, id])
  @@map("tickets")
}

/// Who has a ticket open (collision hint), upserted every 30 s.
model TicketView {
  ticketId Int      @map("ticket_id")
  userId   Int      @map("user_id")
  viewedAt DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
  @@map("ticket_views")
}

/// Overview tiles, kept on write (never count()): `unsolved`, `waiting_on_us`,
/// `solved:YYYY-MM-DD` (the UTC Monday of the week). Changed only by state.ts.
model HelpdeskCounter {
  name      String   @id @db.VarChar(32)
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("helpdesk_counters")
}

/// Saved replies agents insert into the composer (agents manage them). ≤ 100 rows.
model HelpdeskCannedReply {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(80)
  body      String   @db.VarChar(4000)
  position  Int      @default(0)
  createdBy Int      @map("created_by")
  updatedBy Int      @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([position, id])
  @@map("helpdesk_canned_replies")
}

/// Analytics: one row per UTC day, kept by a trigger on `question_logs` (migration
/// helpdesk_analytics): an insert counts the question, its outcome and its cost; a change of
/// `helpful` moves the thumbs. Never written by app code, never `count()`ed per request.
/// A deleted log row leaves its day's numbers as they were (they outlive the log).
model QuestionStatsDaily {
  /// The UTC day the question was asked.
  day         DateTime @id @db.Date
  questions   Int      @default(0)
  answered    Int      @default(0)
  handedOff   Int      @default(0) @map("handed_off")
  noSource    Int      @default(0) @map("no_source")
  aiOff       Int      @default(0) @map("ai_off")
  helpfulUp   Int      @default(0) @map("helpful_up")
  helpfulDown Int      @default(0) @map("helpful_down")
  costMicros  BigInt   @default(0) @map("cost_micros")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("question_stats_daily")
}

// ---------------------------------------------------------------------------
// Knowledge health and Test Lab (Phase 4). CHECKs and the partial indexes
// (health_issues_open_key, test_runs_one_running_key, tickets_draft_unchecked_idx)
// live only in the migration SQL: never let a later migration DROP them.

/// Knowledge health: one thing in the knowledge base that needs a person's look.
/// Written ONLY by background jobs (src/server/knowledge/*) and the accept/dismiss routes.
model HealthIssue {
  id                Int       @id @default(autoincrement())
  /// `gap`, `stale`, `conflict` or `low_rated` (CHECK).
  type              String    @db.VarChar(9)
  /// The article it is about, or the article a draft edits. Null = a new article. SetNull: the
  /// issue outlives a deleted article (shown as "Article deleted"; Accept then creates a new draft).
  articleId         Int?      @map("article_id")
  /// The solved ticket a draft came from. UNIQUE: the DB-level idempotency of `draft-<ticketId>`
  /// (one issue per ticket, whatever its state). Cascade: deleting a ticket (spam) deletes its draft.
  sourceTicketId    Int?      @unique @map("source_ticket_id")
  /// What makes two findings "the same issue": `ticket:<id>`, `article:<id>`, or md5 of a gap
  /// cluster key (`q:<lexemes>` / `a:<articleId>`). Unique per type among OPEN rows (partial index).
  fingerprint       String    @db.VarChar(64)
  /// The owner-local Monday of the weekly run that found or last refreshed it; null for drafts.
  week              DateTime? @db.Date
  /// Snapshot, <= 8 KB (validated where written): counts and up to 5 sample questions (masked).
  evidence          Json      @default("{}")
  suggestedTitle    String    @default("") @map("suggested_title") @db.VarChar(160)
  /// Markdown, <= 20,000 characters. '' = no draft yet.
  suggestedBody     String    @default("") @map("suggested_body") @db.Text
  /// `none`, `pending`, `ready` or `failed` (CHECK).
  draftState        String    @default("none") @map("draft_state") @db.VarChar(8)
  /// Why the last draft failed: `off`, `cap` or `failed` (CHECK), else null.
  draftError        String?   @map("draft_error") @db.VarChar(8)
  /// "Write a draft" presses so far, 0-3 (CHECK). Part of the job key.
  draftAttempts     Int       @default(0) @map("draft_attempts") @db.SmallInt
  /// `open`, `accepted` or `dismissed` (CHECK).
  state             String    @default("open") @db.VarChar(9)
  /// The draft article Accept created or updated. No FK (like created_by): a history value.
  acceptedArticleId Int?      @map("accepted_article_id")
  /// `users.id`, no FK (like kb_articles.created_by).
  resolvedBy        Int?      @map("resolved_by")
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  article      KbArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  sourceTicket Ticket?    @relation(fields: [sourceTicketId], references: [id], onDelete: Cascade)

  /// The screen's list by state, newest first (keyset on id).
  @@index([state, id])
  /// The same, filtered by type.
  @@index([state, type, id])
  /// The FK (SetNull on article delete).
  @@index([articleId])
  /// "Dismissed or accepted in the last 90 days?" (the snooze lookups of the weekly run).
  @@index([type, fingerprint, resolvedAt])
  @@map("health_issues")
}

/// One weekly Knowledge health run: the guard row (one per owner-local week) and its progress.
model KnowledgeHealthRun {
  /// The owner-local Monday ('YYYY-MM-DD') the run belongs to.
  week          DateTime  @id @db.Date
  timeZone      String    @map("time_zone") @db.VarChar(64)
  /// [windowStart, windowEnd): the 7 days before Monday 07:30 local, as instants.
  windowStart   DateTime  @map("window_start") @db.Timestamptz(3)
  windowEnd     DateTime  @map("window_end") @db.Timestamptz(3)
  /// `gaps`, `articles` or `done` (CHECK).
  phase         String    @default("gaps") @db.VarChar(8)
  /// Last kb_articles.id scanned in the `articles` phase.
  cursor        Int       @default(0)
  /// `running`, `done` or `failed` (CHECK).
  state         String    @default("running") @db.VarChar(7)
  gapsFound     Int       @default(0) @map("gaps_found")
  staleFound    Int       @default(0) @map("stale_found")
  lowRatedFound Int       @default(0) @map("low_rated_found")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)

  @@map("knowledge_health_runs")
}

/// A question the owner tests the assistant with (Test Lab). <= 500 rows (enforced in the insert).
model TestCase {
  id                Int       @id @default(autoincrement())
  /// As typed, one line, 3-500.
  question          String    @db.VarChar(500)
  /// normalizeQuestion(question) (src/lib/test-lab.ts): lower-case, single spaces, no trailing
  /// punctuation. UNIQUE: the same question isn't added twice (import dedupe).
  questionKey       String    @unique @map("question_key") @db.VarChar(500)
  /// `answer` (a cited answer passes) or `handoff` (a hand-off passes) (CHECK).
  /// A `handoff` case has no expected article (validated in the routes).
  expect            String    @default("answer") @db.VarChar(8)
  /// The article a right answer cites. SetNull when it is deleted.
  expectedArticleId Int?      @map("expected_article_id")
  lastAnswer        String?   @map("last_answer") @db.VarChar(1200)
  /// `high|medium|low|none`, else null (never run).
  lastConfidence    String?   @map("last_confidence") @db.VarChar(8)
  /// [{id: number|null, title, url}] <= 3, what the answer cited. Snapshot.
  lastSources       Json?     @map("last_sources")
  /// `pass`, `handoff`, `person`, `no_source`, `wrong_source`, `answered_instead`, `cap`, `error`
  /// (CHECK), else null.
  lastOutcome       String?   @map("last_outcome") @db.VarChar(16)
  /// Null = not run (or skipped in its last run).
  lastPassed        Boolean?  @map("last_passed")
  lastRunAt         DateTime? @map("last_run_at") @db.Timestamptz(3)
  /// The run that wrote last*: makes a repeated batch a no-op. No FK.
  lastRunId         Int?      @map("last_run_id")
  createdBy         Int       @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  expectedArticle KbArticle? @relation(fields: [expectedArticleId], references: [id], onDelete: SetNull)

  @@index([expectedArticleId])
  @@map("test_cases")
}

/// One "Run all". At most ONE `running` at a time (partial unique index test_runs_one_running_key).
model TestRun {
  id         Int       @id @default(autoincrement())
  /// `running`, `done`, `cancelled`, `stopped` (cap / AI off) or `failed` (CHECK).
  state      String    @default("running") @db.VarChar(9)
  /// For `stopped` / `failed`: `cap`, `ai_off`, `not_started`, `stalled`, `error` (CHECK), else null.
  stopReason String?   @map("stop_reason") @db.VarChar(12)
  /// Cases when it started (ids <= maxCaseId); cases added later are not in this run.
  total      Int
  maxCaseId  Int       @map("max_case_id")
  /// Cases with a result in this run, and how many passed.
  done       Int       @default(0)
  passed     Int       @default(0)
  /// Last test_cases.id finished; the next batch reads id > cursor.
  cursor     Int       @default(0)
  costMicros BigInt    @default(0) @map("cost_micros")
  startedBy  Int       @map("started_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  @@map("test_runs")
}
